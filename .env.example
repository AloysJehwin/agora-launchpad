# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- Agora (console.agora.io > your project) -------------------------------
# App ID + App Certificate are enough: the REST API accepts a token built from
# them, and the same token lets the agent join the RTC channel.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Optional. Only needed if you prefer Basic auth for the REST API
# (console > RESTful API > Create API Key: Key = customer ID, Secret = secret).
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# --- Murf (murf.ai/api/dashboard > Generate API Key) -----------------------
MURF_API_KEY=
# Falcon voice used by the agent. Must exist in GET /v1/speech/voices?model=falcon-2.1
MURF_VOICE_ID=Matthew
MURF_LOCALE=en-US
# Global routes to the nearest region. For India pin: wss://in.api.murf.ai/v1/speech/stream-input
MURF_WS_URL=wss://global.api.murf.ai/v1/speech/stream-input

# --- LLM -------------------------------------------------------------------
# Leave LLM_API_KEY empty to use Agora managed mode (Agora supplies the OpenAI
# credentials; allowed models: gpt-4o-mini, gpt-4.1-mini, gpt-5-nano, gpt-5-mini).
# Set it to bring your own OpenAI-compatible endpoint instead.
LLM_API_KEY=
LLM_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4.1-mini

# --- Which model talks on a call -------------------------------------------
# Leave VOICE_LLM empty to pick automatically: gemini, then anthropic, then
# LLM_API_KEY, then Agora managed. Set it to gemini | anthropic | openai | managed to force one.
VOICE_LLM=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ASR_LANGUAGE=en-US

# --- Phone calls (Twilio number through an Elastic SIP trunk) --------------
# After filling these, run: npm run phone:setup            (read-only plan)
#                           npm run phone:setup -- --apply (create trunk, import number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The caller ID, in E.164 format, e.g. +14155550100
TWILIO_PHONE_NUMBER=
# The trunk's Termination URI; phone:setup prints the value to use
TWILIO_SIP_HOSTNAME=
# tcp or udp when Secure Trunking is off, tls when it is on
TWILIO_SIP_TRANSPORT=tcp
# Optional SIP username and password (a Twilio credential list on the trunk)
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=
# Comma-separated numbers the server is allowed to dial. Empty = any number.
CALL_ALLOWLIST=

# --- Websites built on calls ------------------------------------------------
# Claude designs the pages (ANTHROPIC_API_KEY above). OpenAI is only a fallback copywriter.
OPENAI_API_KEY=
# Public address of the public listener, and the base domain sites live under
# (<name>.<PUBLIC_HOST>). On the server these live in .env.local instead.
PUBLIC_URL=
PUBLIC_HOST=
TOOL_SECRET=
# whatsapp (text message as fallback until Meta approves a template) | sms | none
LINK_CHANNEL=whatsapp
SMS_FALLBACK=1
TWILIO_WHATSAPP_FROM=
# Google sign-in for site owners. The OAuth client must list PUBLIC_URL as an authorised
# JavaScript origin. Empty = owners sign in with the private link sent to their phone.
GOOGLE_CLIENT_ID=
